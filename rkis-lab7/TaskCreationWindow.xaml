<Window x:Class="WPFLabs.TaskCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFLabs"
        mc:Ignorable="d"
        Title="Создать задачу" Height="394" Width="574">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Название" Margin="5" />
                    <TextBox x:Name="NameTextBox" Padding="7" Margin="5" VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Категория" Margin="5" />
                    <TextBox x:Name="CategoryTextBox" Padding="7" Margin="5" VerticalContentAlignment="Center" Text="Дом">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Описание" Margin="5" />
                    <TextBox x:Name="DescriptionTextBox" Padding="7" Margin="5" Height="110">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
            </StackPanel>
            <Button Grid.Row="1" x:Name="CreateButton" Margin="5" Foreground="White" 
        Background="#FF32BD54" FontSize="16" BorderBrush="{x:Null}" Click="RegistrationButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
                Создать
            </Button>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="43*" />
                    <RowDefinition Height="15*" />
                </Grid.RowDefinitions>
                <DatePicker x:Name="TaskDatePicker" Margin="10,30,10,10" Padding="10">
                    <DatePicker.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
                <TextBox x:Name="TaskTimeTextBox" Grid.Row="1" Margin="10,10,10,10" Padding="10" VerticalContentAlignment="Center" Text="9:00">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
            <Button Grid.Row="1" x:Name="CancelButton" Margin="5" Foreground="White" 
Background="#FFFF4C3A" FontSize="16" BorderBrush="{x:Null}" Click="CancelButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
                Отмена
            </Button>
        </Grid>
    </Grid>
</Window>
